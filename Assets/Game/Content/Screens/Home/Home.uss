/* Home: sign at the top; the rest is laid out bottom-up from the wainscot (play button, coins + album, showcase). */

.home-settings {
    position: absolute;
    top: 6px;
    right: 10px;
    /* .homeGear: 38 x 38 face, 2 px lip and 4 px shadow in the sprite */
    width: 38px;
    height: 44px;
}

.home-settings__icon {
    position: absolute;
    left: 7px;
    top: 7px;
    width: 24px;
    height: 24px;
}

/* Sign and the line under it */

.home-top {
    position: absolute;
    top: 60px;
    left: 0;
    right: 0;
    align-items: center;
}

.home-sign {
    width: 340px;
    /* 12 px drop + soft shadow are inside the sprite's bottom */
    padding: 14px 16px 30px 16px;
    align-items: center;
}

.home-sign__name {
    font-size: 36px;
    color: #FFF3D6;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-shadow: 0 3px 0 #4A2C12;
}

.home-sign__tagline {
    margin-top: 4px;
    font-size: 13px;
    letter-spacing: 5px;
    color: #F3D9A8;
    -unity-text-align: middle-center;
}

.home-subtitle-row {
    margin-top: 2px;
    height: 22px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.home-subtitle {
    font-size: 13px;
    color: var(--ink-2);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.home-reviewers {
    height: 22px;
    padding: 0;
    margin: 0 0 0 3px;
    font-size: 13px;
    color: var(--walnut);
}

/* Bottom block: anchored above the wainscot (its rail is at y = 724). */

.home-bottom {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 132px;
    align-items: stretch;
}

.home-showcase {
    height: 98px;
    margin: 0 -6px 18px -6px;
}

.home-showcase__items {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 21px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.home-showcase__item {
    width: 42px;
    height: 67px;
    margin: 0 1px;
    -unity-background-scale-mode: scale-to-fit;
    background-position-y: bottom;
}

/* 16 px plank + 7 px shadow */
.home-showcase__plank {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 23px;
}

.home-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
}

/* .coins: pill sized to its content */
.home-coins {
    height: 32px;
    margin-top: 6px;
    padding: 0 12px 2px 4px;
}

.home-coins__icon {
    width: 24px;
    height: 24px;
}

.home-coins__value {
    margin-left: 5px;
    font-size: 16px;
    -unity-font-style: bold;
    color: #6B4320;
}

/* Sized to its content: 44 px face + 5 px lip + 6 px shadow below (in the sprite) */
.home-album {
    height: 55px;
    padding: 0 18px 11px 18px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.home-album__text {
    font-size: 16px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.18);
}

.home-album__lock {
    width: 14px;
    height: 16px;
    margin-left: 8px;
}

.home-album__badge {
    position: absolute;
    right: -6px;
    top: -8px;
    width: 24px;
    height: 24px;
    -unity-background-image-tint-color: var(--berry);
    justify-content: center;
}

.home-album__badge-text {
    font-size: 13px;
    color: white;
    -unity-text-align: middle-center;
}

/* 77 px face + 5 px lip + 6 px shadow */
.home-play {
    height: 88px;
}

.home-play__title {
    position: absolute;
    left: 0;
    right: 0;
    top: 12px;
    height: 32px;
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.18);
}

.home-play__line {
    position: absolute;
    left: 0;
    right: 0;
    top: 44px;
    height: 20px;
    font-size: 15px;
    color: white;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.18);
}

.home-play.kit-btn-gold > .home-play__title,
.home-play.kit-btn-gold > .home-play__line {
    color: #5A3A0A;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.4);
}
