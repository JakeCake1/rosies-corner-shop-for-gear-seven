<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Game/Content/Screens/Home/Home.uss" />
    <ui:VisualElement class="home-top" picking-mode="Ignore">
        <ui:VisualElement class="home-sign kit-board-walnut" picking-mode="Ignore">
            <ui:VisualElement class="sign-rope sign-rope--left" picking-mode="Ignore" />
            <ui:VisualElement class="sign-rope sign-rope--right" picking-mode="Ignore" />
            <ui:Label name="shop-name" text="Rosie&apos;s&#10;Corner Shop" class="home-sign__name display-font" />
            <ui:Label name="tagline" text="GROCERIES · BAKERY · SWEETS" class="home-sign__tagline" />
        </ui:VisualElement>
        <ui:VisualElement class="home-subtitle-row" picking-mode="Ignore">
            <ui:Label name="subtitle" text="Prototype" class="home-subtitle" />
            <ui:Label text=" · " class="home-subtitle" />
            <ui:Button name="reviewers" text="&lt;u&gt;For reviewers&lt;/u&gt;" class="btn home-reviewers" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Button name="settings" class="btn kit-btn-gear home-settings">
        <ui:VisualElement class="home-settings__icon icon-gear" picking-mode="Ignore" />
    </ui:Button>
    <ui:VisualElement class="home-bottom" picking-mode="Ignore">
        <ui:VisualElement class="home-showcase" picking-mode="Ignore">
            <ui:VisualElement name="showcase-items" class="home-showcase__items" picking-mode="Ignore">
                <ui:VisualElement class="home-showcase__item" />
                <ui:VisualElement class="home-showcase__item" />
                <ui:VisualElement class="home-showcase__item" />
                <ui:VisualElement class="home-showcase__item" />
                <ui:VisualElement class="home-showcase__item" />
                <ui:VisualElement class="home-showcase__item" />
                <ui:VisualElement class="home-showcase__item" />
            </ui:VisualElement>
            <ui:VisualElement class="home-showcase__plank kit-plank" />
        </ui:VisualElement>
        <ui:VisualElement class="home-bar" picking-mode="Ignore">
            <ui:VisualElement class="home-coins chip kit-chip" picking-mode="Ignore">
                <ui:VisualElement class="home-coins__icon icon-coin" />
                <ui:Label name="coins-value" text="150" class="home-coins__value" />
            </ui:VisualElement>
            <ui:Button name="album" class="btn kit-btn-grey home-album">
                <ui:Label name="album-text" text="Album" class="home-album__text" />
                <ui:VisualElement name="album-lock" class="home-album__lock icon-lock" picking-mode="Ignore" />
                <ui:VisualElement name="album-badge" class="home-album__badge kit-circle" picking-mode="Ignore">
                    <ui:Label name="album-badge-text" text="3" class="home-album__badge-text" />
                </ui:VisualElement>
            </ui:Button>
        </ui:VisualElement>
        <ui:Button name="play" class="btn kit-btn-berry home-play">
            <ui:Label name="play-title" text="Open the shop" class="home-play__title" />
            <ui:Label name="play-line" text="Level 1" class="home-play__line" />
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
