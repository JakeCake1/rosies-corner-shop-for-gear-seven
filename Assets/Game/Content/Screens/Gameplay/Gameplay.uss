/*
 * Gameplay screen (02_game_L01_start.png, 03_*.png). Board blocks are positioned by BoardView; the sizes and
 * offsets below are prototype CSS pixels.
 */

.board,
.flight,
.basket-area__baskets,
.counter__slots,
.shelf,
.shelf__content,
.shelf__layer,
.basket,
.basket__slots,
.basket__back,
.basket__front,
.booster {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* HUD */

.hud {
    position: absolute;
    top: 6px;
    left: 50%;
    width: 370px;
    height: 50px;
    margin-left: -185px;
}

.hud-badge {
    position: absolute;
    left: 0;
    top: -2px;
    width: 52px;
    height: 54px;
}

.hud-badge__title {
    position: absolute;
    top: 8px;
    left: 0;
    right: 0;
    height: 12px;
    font-size: 9px;
    letter-spacing: 1px;
    color: var(--walnut);
    -unity-text-align: middle-center;
}

.hud-badge__number {
    position: absolute;
    top: 14px;
    bottom: 4px;
    left: 0;
    right: 0;
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--walnut);
    -unity-text-align: middle-center;
}

/* Tricky levels: red badge with white "TRICKY" and number (03_game_L20_tricky.png) */
.hud-badge.kit-badge-red > .hud-badge__title {
    color: white;
}

.hud-badge.kit-badge-red > .hud-badge__number {
    color: white;
    text-shadow: 0 2px 0 rgba(122, 28, 36, 0.5);
}

.hud-progress {
    position: absolute;
    left: 60px;
    right: 148px;
    top: 10px;
    height: 30px;
}

.hud-progress__area {
    position: absolute;
    left: 3px;
    top: 3px;
    right: 3px;
    bottom: 3px;
}

.hud-progress__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
}

.hud-progress__text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 2px;
    font-size: 17px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
}

.hud-coins {
    position: absolute;
    right: 50px;
    top: 8px;
    width: 92px;
    height: 34px;
}

.hud-settings {
    position: absolute;
    right: 0;
    top: 3px;
    /* .gear: 40 x 40 face, 2 px lip and 4 px shadow in the sprite */
    width: 40px;
    height: 46px;
}

.hud-settings__icon {
    position: absolute;
    left: 9px;
    top: 9px;
    width: 22px;
    height: 22px;
}

/* Baskets */

.basket-area,
.counter,
.cabinet {
    position: absolute;
}

.basket-area__ledge {
    position: absolute;
    left: -2%;
    right: -2%;
    bottom: 16px;
    height: 22px;
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/ledge.png");
    background-repeat: repeat no-repeat;
    background-size: 20px 22px;
}

.basket-lock {
    position: absolute;
    top: 0;
    width: 108px;
    height: 92px;
}

.basket-lock__ghost {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/Game/Content/Visual/Gameplay/basket/basket_front.png");
    opacity: 0.35;
}

.basket-lock__plus {
    position: absolute;
    left: 32px;
    top: 18px;
    width: 44px;
    height: 44px;
    -unity-background-image-tint-color: var(--leaf);
    justify-content: center;
}

.basket-lock__plus-text {
    font-size: 34px;
    color: white;
    -unity-text-align: middle-center;
    padding-bottom: 4px;
}

.basket__back {
    background-image: url("project://database/Assets/Game/Content/Visual/Gameplay/basket/basket_back.png");
}

.basket__front {
    background-image: url("project://database/Assets/Game/Content/Visual/Gameplay/basket/basket_front.png");
}

.basket__slot {
    position: absolute;
    top: 4px;
    width: 34px;
    height: 54px;
}

.basket__slot--0 {
    left: 12px;
}

.basket__slot--1 {
    left: 37px;
}

.basket__slot--2 {
    left: 62px;
}

.basket__napkin {
    position: absolute;
    top: 20px;
    left: 10px;
    width: 88px;
    height: 40px;
    background-image: url("project://database/Assets/Game/Content/Visual/Gameplay/basket/napkin_done.png");
    -unity-background-scale-mode: scale-to-fit;
}

.basket__tag {
    position: absolute;
    top: 82px;
    left: 22px;
    width: 64px;
    height: 30px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.basket__tag-icon {
    width: 16px;
    height: 24px;
    margin-bottom: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.basket__tag-count {
    margin-left: 4px;
    padding-bottom: 2px;
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--ink);
}

/* Counter */

.counter-slot {
    position: absolute;
}

.counter-slot__doily {
    position: absolute;
    left: 50%;
    bottom: -8px;
    width: 56px;
    height: 20px;
    margin-left: -28px;
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/doily.png");
}

.counter-slot__doily--hot {
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/doily_hot.png");
}

.counter__label {
    position: absolute;
    right: 14px;
    bottom: 4px;
    width: 140px;
    height: 16px;
    font-size: 11px;
    letter-spacing: 2px;
    color: #FFF6E8;
    -unity-text-align: middle-right;
}

/* Cabinet */

.cabinet__awning {
    position: absolute;
    left: -3%;
    right: -3%;
    top: -14px;
    height: 38px;
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/awning.png");
    background-repeat: repeat no-repeat;
    background-size: 52px 38px;
    /* Tiles from the middle so both ends cut the stripes the same way. */
    background-position-x: center;
}

.cabinet__tabs {
    position: absolute;
    top: 22px;
    left: 12px;
    right: 12px;
    height: 26px;
    flex-direction: row;
}

.stock-tab {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 2px;
    align-items: center;
    justify-content: center;
}

/* .colTag: compact pill sized to its text, centred over its column */
.stock-tab__pill {
    height: 22px;
    padding: 0 9px 1px 9px;
    flex-direction: row;
    align-items: center;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.85);
}

.stock-tab__text {
    margin: 0;
    padding: 0;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--ink-2);
    -unity-text-align: middle-center;
}

.stock-tab__hammer {
    margin-left: 3px;
    width: 14px;
    height: 20px;
    background-image: url("project://database/Assets/Game/Content/Visual/Gameplay/tools/hammer.png");
    -unity-background-scale-mode: scale-to-fit;
    display: none;
}

.cabinet__columns {
    position: absolute;
    /* BoardLayout.ColumnInset: a gap between the outer columns and the cabinet frame */
    left: 13px;
    right: 13px;
    bottom: 11px;
    height: 300px;
    flex-direction: row;
}

/* Clips shelves dropping in from the stock, like the prototype's .col { overflow: hidden }. */
.cabinet__column {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 2px;
    overflow: hidden;
    /* The back panel stays where shelves have gone (02_game_L01_midplay.png). */
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/shelf_back.png");
    -unity-slice-left: 8;
    -unity-slice-top: 8;
    -unity-slice-right: 8;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 1px;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.7);
}

/* Shelves */

.shelf-slot {
    position: absolute;
    left: 0;
    right: 0;
    transform-origin: 50% 100%;
}

.shelf__post {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 5px;
}

.shelf__post--left {
    left: 0;
}

.shelf__post--right {
    right: 0;
}

.shelf__cap {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
}

.shelf__floor {
    position: absolute;
    left: 0;
    right: 0;
    height: 8px;
}

.shelf__cell {
    position: absolute;
}

.shelf__ghost {
    position: absolute;
    left: 7px;
    right: -7px;
    top: -5px;
    bottom: 5px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(217, 217, 217, 0.5);
}

.shelf__rows {
    position: absolute;
    top: -8px;
    left: 50%;
    width: 52px;
    height: 17px;
    margin-left: -26px;
    -unity-background-image-tint-color: #5A3A1C;
    justify-content: center;
}

.shelf__rows-text {
    font-size: 10px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    padding-bottom: 1px;
}

/*
 * .s.hasBack::after: "+1" on a slot with an item behind it. ShelfView places it (26 x 16 at the slot's top right).
 * UI Toolkit has no dashed borders; a solid 1px border keeps the look.
 */
.shelf__back-mark {
    position: absolute;
    width: 26px;
    height: 16px;
    padding: 0;
    margin: 0;
    font-size: 10px;
    -unity-font-style: bold;
    color: #7A4A9A;
    -unity-text-align: middle-center;
    background-color: rgba(255, 248, 234, 0.92);
    border-width: 1px;
    border-color: #7A4A9A;
    border-radius: 8px;
}

/* Frame tone by block height (.blk.h2 orange, .blk.h3 walnut); the kit sprites are light oak. */
.shelf--h2 .shelf__post,
.shelf--h2 .shelf__cap,
.shelf--h2 .shelf__floor {
    -unity-background-image-tint-color: #E0904A;
}

.shelf--h3 .shelf__post,
.shelf--h3 .shelf__cap,
.shelf--h3 .shelf__floor {
    -unity-background-image-tint-color: #7A4E2C;
}

.shelf__twine {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 2px;
    bottom: 2px;
    background-image: url("project://database/Assets/Game/Content/Visual/Gameplay/shelf/tie_twine.png");
}

.shelf__seal {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 34px;
    height: 34px;
    margin-left: -17px;
    margin-top: -17px;
    background-image: url("project://database/Assets/Game/Content/Visual/Gameplay/shelf/tie_seal.png");
    -unity-background-scale-mode: scale-to-fit;
}

.shelf__key {
    position: absolute;
    left: 50%;
    bottom: -22px;
    width: 20px;
    height: 26px;
    margin-left: -10px;
    background-image: url("project://database/Assets/Game/Content/Visual/Gameplay/shelf/key_tag.png");
    -unity-background-scale-mode: scale-to-fit;
}

.key-flyer {
    position: absolute;
    background-image: url("project://database/Assets/Game/Content/Visual/Gameplay/shelf/key_tag.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* .blk .ice: inset 3px 1px 0 */
.shelf__ice {
    left: 1px;
    top: 3px;
    right: 1px;
    bottom: 0;
}

/* ".ice b": blue pill centred on the block, "snowflake N" */
.shelf__ice-badge {
    position: absolute;
    top: 50%;
    left: 50%;
    height: 26px;
    padding: 0 10px 0 8px;
    translate: -50% -50%;
    flex-direction: row;
    align-items: center;
    -unity-background-image-tint-color: #2F7BD6;
}

.shelf__ice-flake {
    width: 14px;
    height: 14px;
    margin-right: 4px;
}

.shelf__ice-text {
    font-size: 16px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    padding-bottom: 2px;
}

.shelf__board {
    position: absolute;
    left: -2px;
    right: -2px;
    height: 24%;
}

.shelf__board--0 {
    bottom: 8%;
    rotate: 2deg;
}

.shelf__board--1 {
    bottom: 40%;
    rotate: -3deg;
}

.shelf__board--2 {
    bottom: 72%;
    rotate: 2deg;
}

.shelf__hammer {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 26px;
    height: 40px;
    margin-left: -13px;
    margin-top: -20px;
    background-image: url("project://database/Assets/Game/Content/Visual/Gameplay/tools/hammer.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* Items */

.item {
    position: absolute;
}

.item__image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* Boosters */

.booster-bar {
    position: absolute;
    bottom: 10px;
    left: 50%;
    width: 358px;
    height: 90px;
    margin-left: -179px;
    padding: 0 12px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.booster-slot {
    width: 70px;
    height: 88px;
}

.booster__glow {
    position: absolute;
    left: -3px;
    top: -6px;
    width: 76px;
    height: 76px;
    -unity-background-image-tint-color: rgb(255, 217, 102);
}

.booster__tile {
    position: absolute;
    left: 5px;
    top: 0;
    width: 60px;
    height: 60px;
    -unity-background-image-tint-color: #FFF8EA;
}

.booster__icon {
    position: absolute;
    left: 7px;
    top: 7px;
    right: 7px;
    bottom: 7px;
    -unity-background-scale-mode: scale-to-fit;
}

.booster__badge {
    position: absolute;
    right: -8px;
    top: -8px;
    width: 24px;
    height: 24px;
    -unity-background-image-tint-color: var(--berry);
    justify-content: center;
}

.booster__badge--plus {
    -unity-background-image-tint-color: var(--leaf);
}

.booster__count {
    font-size: 14px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    padding-bottom: 2px;
}

.booster__title {
    position: absolute;
    bottom: 2px;
    left: -10px;
    width: 90px;
    height: 22px;
    font-size: 13px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(63, 39, 20);
}

/* Level banner */

.banner {
    height: 110px;
}

/* Hugs its title ("Level 1" ~200 px in 02_game_L01_start.png), centred over the counter */
.banner__ribbon {
    position: absolute;
    top: 0;
    left: 50%;
    height: 52px;
    padding: 0 40px;
    translate: -50% 0;
    justify-content: center;
}

.banner__title {
    font-size: 26px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
    white-space: nowrap;
}

.banner__tip {
    position: absolute;
    top: 50px;
    left: 15px;
    width: 290px;
    height: 56px;
    padding: 6px 12px 8px 12px;
    justify-content: center;
}

.banner__tip-text {
    font-size: 15px;
    color: var(--ink);
    -unity-text-align: middle-center;
    white-space: normal;
}
