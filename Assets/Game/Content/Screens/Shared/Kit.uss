/* Pressed buttons: same slices; .btn:active (Game.uss) moves the button down so the 1 px lip keeps its ground. */
.kit-btn-berry:active {
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/btn_berry_pressed.png");
}

.kit-btn-gear:active {
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/btn_gear_pressed.png");
