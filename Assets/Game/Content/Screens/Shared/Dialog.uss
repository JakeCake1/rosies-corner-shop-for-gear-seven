/* Modal card (DialogWindow): 330 px wide, centred 10 px below the screen centre. */

.dialog-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    padding-top: 20px;
}

.dialog-card {
    width: 330px;
    /* Every body child adds 10 px below itself, so the bottom padding is 22 - 10. */
    padding: 40px 20px 12px 20px;
}

/* The ribbon hugs its title, as in the mockups ("Settings" ~130px, "Tricky level complete" ~240px). */
.dialog-ribbon-row {
    position: absolute;
    top: -23px;
    left: 0;
    right: 0;
    height: 46px;
    flex-direction: row;
    justify-content: center;
}

.dialog-ribbon {
    height: 46px;
    min-width: 130px;
    max-width: 310px;
    justify-content: center;
}

.dialog-ribbon__title {
    font-size: 21px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    margin: 0 30px 8px 30px;
    white-space: nowrap;
}

.dialog-body > * {
    margin-bottom: 10px;
}

.dialog-icon {
    height: 96px;
    -unity-background-scale-mode: scale-to-fit;
}

.dialog-stars {
    height: 72px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

.dialog-star {
    width: 52px;
    height: 52px;
    margin: 10px 5px 0 5px;
}

.dialog-star--big {
    width: 68px;
    height: 68px;
    margin-top: 0;
}

.dialog-headline {
    -unity-font: url("project://database/Assets/Game/Content/Visual/Fonts/YesevaOne-Regular.ttf");
    -unity-font-definition: initial;
    font-size: 26px;
    color: var(--walnut);
    -unity-text-align: middle-center;
    white-space: normal;
}

.dialog-text {
    font-size: 17px;
    color: var(--ink);
    -unity-text-align: middle-center;
    white-space: normal;
}

.dialog-stat {
    height: 34px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
    -unity-background-image-tint-color: #F3E8D8;
}

.dialog-stat__label {
    font-size: 16px;
    color: var(--ink-2);
}

.dialog-stat__value {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--ink);
}

.dialog-progress__caption {
    font-size: 19px;
    -unity-font-style: bold;
    color: var(--walnut);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.dialog-progress__track {
    height: 20px;
    padding: 3px;
}

.dialog-progress__fill {
    height: 100%;
}

.dialog-items {
    height: 60px;
    flex-direction: row;
    justify-content: center;
}

.dialog-items__item {
    width: 36px;
    height: 58px;
    margin: 0 1px;
    -unity-background-scale-mode: scale-to-fit;
}

.dialog-reward {
    height: 40px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.dialog-reward__coin {
    width: 30px;
    height: 30px;
    margin-right: 6px;
}

.dialog-reward__amount {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--walnut);
}

.dialog-toggle {
    height: 54px;
    flex-direction: row;
    align-items: center;
    padding: 0 14px;
    -unity-background-image-tint-color: #F3E8D8;
}

.dialog-toggle__label {
    flex-grow: 1;
    font-size: 18px;
    color: var(--ink);
}

.dialog-switch {
    width: 52px;
    height: 30px;
    -unity-background-image-tint-color: rgb(191, 179, 163);
}

.dialog-switch--on {
    -unity-background-image-tint-color: var(--leaf);
}

.dialog-switch__knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 24px;
    height: 24px;
    -unity-background-image-tint-color: white;
}

.dialog-switch--on > .dialog-switch__knob {
    left: 25px;
}

.dialog-input__field {
    height: 46px;
    margin: 0 0 8px 0;
}

.dialog-input__field > .unity-base-text-field__input {
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/rounded_white.png");
    -unity-slice-left: 16;
    -unity-slice-top: 16;
    -unity-slice-right: 16;
    -unity-slice-bottom: 16;
    -unity-slice-scale: 0.5px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0 12px;
    font-size: 20px;
    color: var(--ink);
    -unity-text-align: middle-left;
}

.dialog-input__ideas {
    height: 34px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.dialog-chip {
    width: 104px;
    height: 30px;
    margin: 0 3px;
    font-size: 12px;
    color: var(--ink);
    padding-bottom: 2px;
}

.dialog-grid {
    height: 180px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-content: center;
}

.dialog-grid__cell {
    width: 44px;
    height: 40px;
    margin: 3px;
    font-size: 18px;
    color: white;
    -unity-background-image-tint-color: #E7B77C;
}

.dialog-grid__cell--current {
    -unity-background-image-tint-color: var(--berry);
}

.dialog-segments__label {
    font-size: 15px;
    color: var(--ink-2);
    margin-bottom: 4px;
}

.dialog-segments__options {
    height: 36px;
    flex-direction: row;
}

.dialog-segment {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 3px;
    font-size: 15px;
    color: var(--ink);
    -unity-background-image-tint-color: rgb(247, 237, 209);
}

.dialog-segment--on {
    -unity-background-image-tint-color: var(--leaf);
    color: white;
}

.dialog-note {
    font-size: 13px;
    color: var(--ink-2);
    -unity-text-align: middle-center;
    white-space: normal;
}

.dialog-row {
    flex-direction: row;
}

.dialog-row > .dialog-button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 5px;
}

.dialog-button {
    height: 58px;
}

.dialog-button--small {
    height: 44px;
}

.dialog-button--tall {
    height: 70px;
}

.dialog-button__content {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin: 4px 10px 9px 10px;
}

.dialog-button__labels {
    align-items: center;
}

.dialog-button__label {
    font-size: 22px;
    -unity-font-style: bold;
    color: white;
    white-space: nowrap;
}

.dialog-button--small .dialog-button__label {
    font-size: 18px;
}

.dialog-button__sub {
    font-size: 14px;
    color: white;
}

.dialog-button__label,
.dialog-button__sub {
    text-shadow: 0 2px 0 rgba(94, 60, 32, 0.45);
}

.dialog-button__ad {
    width: 32px;
    height: 22px;
    margin-right: 8px;
    justify-content: center;
}

.dialog-button__ad-text {
    font-size: 13px;
    color: var(--leaf);
    -unity-text-align: middle-center;
}

.dialog-button__coin {
    flex-direction: row;
    align-items: center;
    margin-right: 8px;
}

.dialog-button__coin-icon {
    width: 24px;
    height: 24px;
    margin-right: 4px;
}

.dialog-button__price {
    font-size: 20px;
    color: var(--ink);
}
