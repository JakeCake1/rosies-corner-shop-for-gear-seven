/*
 * Shared look of the game: palette, fonts, layers, buttons and overlays.
 * One USS pixel equals one CSS pixel of the prototype (PanelSettings: 390x844 reference, match 0.5).
 */

:root {
    --ink: #3B2A1B;
    --ink-2: #7A6049;
    --cream: #FFF8EA;
    --walnut: #5E3C20;
    --berry: #C63D4E;
    --leaf: #5F9A46;
    --gold: #EDB53F;
    --oak-dark: #96622F;

    -unity-font: url("project://database/Assets/Game/Content/Visual/Fonts/Fredoka-SemiBold.ttf");
    -unity-font-definition: initial;
    color: var(--ink);
    font-size: 16px;
}

.unity-text-element {
    -unity-font: url("project://database/Assets/Game/Content/Visual/Fonts/Fredoka-SemiBold.ttf");
    -unity-font-definition: initial;
    margin: 0;
    padding: 0;
}

.display-font {
    -unity-font: url("project://database/Assets/Game/Content/Visual/Fonts/YesevaOne-Regular.ttf");
    -unity-font-definition: initial;
}

/* Layers (Root.uxml) */

.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #F4E6CC;
}

.wallpaper {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/wallpaper.png");
    background-repeat: repeat repeat;
    background-size: 36px 36px;
}

.wainscot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 120px;
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/wainscot.png");
    background-repeat: repeat repeat;
    background-size: 42px 60px;
    background-position-y: bottom;
}

.wainscot__rail {
    position: absolute;
    left: 0;
    right: 0;
    top: -4px;
    height: 8px;
}

.bunting {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 44px;
    -unity-background-scale-mode: stretch-to-fill;
}

.tricky-tint {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(199, 61, 79, 1);
    opacity: 0;
}

.blocker {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(41, 23, 13, 0.6);
}

.window-shield {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Buttons: the default theme's look is replaced by kit sprites. */

.btn {
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.btn:hover {
    background-color: rgba(0, 0, 0, 0);
}

.btn:active {
    -unity-background-image-tint-color: rgb(217, 217, 217);
    background-color: rgba(0, 0, 0, 0);
}

.btn:disabled {
    -unity-background-image-tint-color: rgba(191, 191, 191, 0.6);
    opacity: 0.6;
}

.chip {
    flex-direction: row;
    align-items: center;
}

.chip__coin {
    width: 24px;
    height: 24px;
    margin-left: 6px;
}

.chip__value {
    -unity-font-style: bold;
    font-size: 17px;
    color: var(--ink);
    margin-left: 4px;
    padding-bottom: 3px;
}

/* Hanging signs (home, album) */

.sign-rope {
    position: absolute;
    top: -42px;
    width: 3px;
    height: 44px;
    background-color: #8C6A3E;
    border-radius: 1px;
}

.sign-rope--left {
    left: 76px;
}

.sign-rope--right {
    right: 76px;
}

/* Overlay */

.toast {
    position: absolute;
    top: 96px;
    left: 50%;
    width: 300px;
    margin-left: -150px;
    min-height: 44px;
    padding: 6px 14px 8px 14px;
    justify-content: center;
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/pill_white.png");
    -unity-slice-left: 30;
    -unity-slice-top: 30;
    -unity-slice-right: 30;
    -unity-slice-bottom: 30;
    -unity-slice-scale: 0.5px;
    -unity-background-image-tint-color: rgba(59, 41, 28, 0.92);
}

.toast--warning {
    -unity-background-image-tint-color: rgba(199, 61, 79, 0.95);
}

.toast__text {
    font-size: 17px;
    color: white;
    -unity-text-align: middle-center;
    white-space: normal;
}

.coach-bubble {
    position: absolute;
    width: 270px;
    padding: 10px 14px 12px 14px;
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/card.png");
    -unity-slice-left: 54;
    -unity-slice-top: 54;
    -unity-slice-right: 54;
    -unity-slice-bottom: 54;
    -unity-slice-scale: 0.5px;
}

.coach-bubble__text {
    font-size: 16px;
    color: var(--ink);
    -unity-text-align: middle-center;
    white-space: normal;
}

.coach-hand {
    position: absolute;
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Icons/tutorial_hand.png");
    -unity-background-scale-mode: scale-to-fit;
}

.particle {
    position: absolute;
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/circle.png");
}

.praise {
    position: absolute;
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(110, 29, 41);
    white-space: nowrap;
}

.praise--combo {
    font-size: 30px;
    color: rgb(237, 181, 64);
}
