/*
 * Shared look of the game: palette, fonts, layers, buttons and overlays.
 * One USS pixel equals one CSS pixel of the prototype (PanelSettings: 390x844 reference, match 0.5).
 */

:root {
    --ink: #3B2A1B;
    --ink-2: #7A6049;
    --cream: #FFF8EA;
    --walnut: #5E3C20;
    --berry: #C63D4E;
    --leaf: #5F9A46;
    --gold: #EDB53F;
    --oak-dark: #96622F;

    -unity-font: url("project://database/Assets/Game/Content/Visual/Fonts/Fredoka-SemiBold.ttf");
    -unity-font-definition: initial;
    color: var(--ink);
    font-size: 16px;
}

.unity-text-element {
    -unity-font: url("project://database/Assets/Game/Content/Visual/Fonts/Fredoka-SemiBold.ttf");
    -unity-font-definition: initial;
    margin: 0;
    padding: 0;
}

.display-font {
    -unity-font: url("project://database/Assets/Game/Content/Visual/Fonts/YesevaOne-Regular.ttf");
    -unity-font-definition: initial;
}

/* Layers (Root.uxml) */

.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #F4E6CC;
}

.wallpaper {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/wallpaper.png");
    background-repeat: repeat repeat;
    background-size: 36px 36px;
}

.wainscot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 120px;
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/wainscot.png");
    background-repeat: repeat repeat;
    background-size: 42px 60px;
    background-position-y: bottom;
}

.wainscot__rail {
    position: absolute;
    left: 0;
    right: 0;
    top: -4px;
    height: 8px;
}

.bunting {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 44px;
    -unity-background-scale-mode: stretch-to-fill;
}

.tricky-tint {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    /* #game.tricky: crossed 45 deg berry stripes (gingham) over the wallpaper */
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/gingham.png");
    background-repeat: repeat repeat;
    background-size: 45px 45px;
    opacity: 0;
}

.blocker {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(41, 23, 13, 0.6);
}

.window-shield {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Buttons: the default theme's look is replaced by kit sprites. */

.btn {
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/*
 * The default theme paints a grey background and border on hover/press/focus with selectors such as
 * .unity-button:hover:active:enabled; .unity-button.btn plus the same states outranks every one of them.
 */
.unity-button.btn:hover,
.unity-button.btn:hover:enabled,
.unity-button.btn:active,
.unity-button.btn:active:enabled,
.unity-button.btn:focus,
.unity-button.btn:focus:enabled,
.unity-button.btn:hover:active,
.unity-button.btn:hover:active:enabled,
.unity-button.btn:hover:focus,
.unity-button.btn:hover:focus:enabled,
.unity-button.btn:active:focus,
.unity-button.btn:active:focus:enabled,
.unity-button.btn:hover:active:focus,
.unity-button.btn:hover:active:focus:enabled {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
}

/* Press: lipped kit buttons sink by the lip (the prototype's .btn:active translateY(4px)) and switch to the
   *_pressed sprite with a 1 px lip (Kit.uss). */
.btn {
    transition-property: translate;
    transition-duration: 0.08s;
    transition-timing-function: ease-out;
}

.btn.kit-btn-berry:active,
.btn.kit-btn-gold:active,
.btn.kit-btn-green:active,
.btn.kit-btn-grey:active,
.btn.kit-btn-wood:active {
    translate: 0 4px;
}

.btn.kit-btn-gear:active {
    translate: 0 1px;
}

.btn:disabled {
    -unity-background-image-tint-color: rgba(191, 191, 191, 0.6);
    opacity: 0.6;
}

.chip {
    flex-direction: row;
    align-items: center;
}

.chip__coin {
    width: 24px;
    height: 24px;
    margin-left: 6px;
}

.chip__value {
    -unity-font-style: bold;
    font-size: 17px;
    color: var(--ink);
    margin-left: 4px;
    padding-bottom: 3px;
}

/* Hanging signs (home, album) */

/* Ropes hang from the bunting string (y = 13..15 px at the rope positions) down onto the sign. */
.sign-rope {
    position: absolute;
    top: -48px;
    width: 4px;
    height: 52px;
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/rope.png");
    background-repeat: repeat-y;
    background-size: 4px 8px;
}

.sign-rope--left {
    left: 76px;
}

.sign-rope--right {
    right: 76px;
}

/* Overlay */

.toast {
    position: absolute;
    top: 96px;
    left: 50%;
    width: 300px;
    margin-left: -150px;
    min-height: 44px;
    padding: 6px 14px 8px 14px;
    justify-content: center;
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/pill_white.png");
    -unity-slice-left: 30;
    -unity-slice-top: 30;
    -unity-slice-right: 30;
    -unity-slice-bottom: 30;
    -unity-slice-scale: 1px;
    -unity-background-image-tint-color: rgba(59, 41, 28, 0.92);
}

.toast--warning {
    -unity-background-image-tint-color: rgba(199, 61, 79, 0.95);
}

/* Tip that pops up above a button: zero-size anchor at the button's top centre, white pill with a shadow. */
.toast-tip {
    position: absolute;
    width: 0;
    height: 0;
}

.toast-tip__pill {
    position: absolute;
    right: 0;
    bottom: 0;
    transform-origin: 100% 100%;
    padding: 9px 18px 16px 18px;
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/pill_shadow.png");
    -unity-slice-left: 42;
    -unity-slice-top: 38;
    -unity-slice-right: 42;
    -unity-slice-bottom: 54;
    -unity-slice-scale: 1px;
}

.toast-tip__text {
    font-size: 15px;
    color: var(--ink);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.toast__text {
    font-size: 17px;
    color: white;
    -unity-text-align: middle-center;
    white-space: normal;
}

.coach-bubble {
    position: absolute;
    width: 270px;
    padding: 10px 14px 12px 14px;
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/card.png");
    -unity-slice-left: 54;
    -unity-slice-top: 54;
    -unity-slice-right: 54;
    -unity-slice-bottom: 54;
    -unity-slice-scale: 1px;
}

.coach-bubble__text {
    font-size: 16px;
    color: var(--ink);
    -unity-text-align: middle-center;
    white-space: normal;
}

.coach-hand {
    position: absolute;
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Icons/tutorial_hand.png");
    -unity-background-scale-mode: scale-to-fit;
}

.particle {
    position: absolute;
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/circle.png");
}

.praise {
    position: absolute;
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(110, 29, 41);
    white-space: nowrap;
}

.praise--combo {
    font-size: 30px;
    color: rgb(237, 181, 64);
}
