/* Album window (09_album.png), prototype CSS pixels. */

/* Covers the home screen with the same shop wallpaper; blocks taps to it. */
.album-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #F4E6CC;
}

.album-back {
    position: absolute;
    left: 16px;
    top: 15px;
    /* 40 px face + 5 px lip + 6 px shadow in the sprite */
    width: 65px;
    height: 46px;
}

.album-back__text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 11px;
    font-size: 17px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.18);
}

/* Counter pill ("19 / 162"), sized to its text */
.album-total {
    position: absolute;
    right: 18px;
    top: 17px;
    height: 34px;
    padding: 0 14px 2px 14px;
    justify-content: center;
}

.album-total__text {
    font-size: 16px;
    -unity-font-style: bold;
    color: #6B4320;
    -unity-text-align: middle-center;
}

/* Same walnut sign as home: 76 px face, the drop and shadow are inside the sprite's bottom */
.album-sign {
    position: absolute;
    top: 102px;
    left: 50%;
    width: 340px;
    height: 90px;
    margin-left: -170px;
}

/* The ropes start under the counter pill (y 62 in 09_album.png), so they don't cross it. */
.album-sign > .sign-rope {
    top: -40px;
    height: 44px;
}

.album-sign__title {
    position: absolute;
    left: 0;
    right: 0;
    top: 6px;
    height: 42px;
    font-size: 30px;
    color: #FFF3D6;
    -unity-text-align: middle-center;
    text-shadow: 0 3px 0 #4A2C12;
}

.album-sign__subtitle {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
    height: 16px;
    font-size: 11px;
    letter-spacing: 5px;
    color: #F3D9A8;
    -unity-text-align: middle-center;
}

/* Ends 16 px above the screen edge with rounded bottom corners. */
.album-cabinet {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 198px;
    bottom: 16px;
    padding: 8px;
    background-color: var(--walnut);
    border-radius: 24px;
}

.album-cabinet__inner {
    flex-grow: 1;
    background-color: #B0C39A;
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/wainscot.png");
    background-repeat: repeat repeat;
    background-size: 42px 60px;
    border-radius: 16px;
    overflow: hidden;
}

.album-scroll {
    flex-grow: 1;
}

.album-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding: 4px 8px 16px 8px;
}

.album-section {
    height: 29px;
    margin: 12px 2px 6px 2px;
    padding: 0 12px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(255, 248, 234, 0.94);
    border-radius: 15px;
}

.album-section__title {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--ink);
}

.album-section__title--done {
    color: #C9922B;
}

.album-section__count {
    font-size: 12px;
    color: var(--ink-2);
}

/* Row pitch follows 09_album.png: 104px from plank to plank, items ~55px tall with a two-line name. */
.album-row {
    flex-direction: row;
    align-items: flex-end;
    height: 86px;
    margin-top: 6px;
}

.album-cell {
    width: 16.666%;
    align-items: center;
    justify-content: flex-end;
}

.album-cell__image {
    width: 48px;
    height: 62px;
    -unity-background-scale-mode: scale-to-fit;
    background-position-y: bottom;
}

.album-cell__name {
    height: 22px;
    margin-top: 0;
    font-size: 10px;
    color: var(--ink);
    -unity-text-align: upper-center;
    white-space: normal;
}

.album-plank {
    height: 12px;
    margin: 2px 0 0 0;
}
