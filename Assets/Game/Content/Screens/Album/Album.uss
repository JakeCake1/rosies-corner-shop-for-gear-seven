/* Album window (09_album.png), prototype CSS pixels. */

/* Covers the home screen with the same shop wallpaper; blocks taps to it. */
.album-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #F4E6CC;
}

.album-back {
    position: absolute;
    left: 16px;
    top: 15px;
    width: 65px;
    height: 40px;
}

.album-back__text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 5px;
    font-size: 17px;
    color: white;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 0 rgba(94, 60, 32, 0.45);
}

.album-total {
    position: absolute;
    right: 18px;
    top: 17px;
    width: 86px;
    height: 32px;
    justify-content: center;
}

.album-total__text {
    font-size: 16px;
    color: var(--ink);
    -unity-text-align: middle-center;
}

.album-sign {
    position: absolute;
    top: 102px;
    left: 50%;
    width: 340px;
    height: 76px;
    margin-left: -170px;
}

.album-sign__title {
    position: absolute;
    left: 0;
    right: 0;
    top: 4px;
    height: 46px;
    font-size: 32px;
    color: var(--cream);
    -unity-text-align: middle-center;
}

.album-sign__subtitle {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 13px;
    height: 16px;
    font-size: 11px;
    letter-spacing: 3px;
    color: #E2C38A;
    -unity-text-align: middle-center;
}

.album-cabinet {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 191px;
    bottom: -24px;
    padding: 8px 8px 0 8px;
    background-color: var(--walnut);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
}

.album-cabinet__inner {
    flex-grow: 1;
    background-color: #B0C39A;
    background-image: url("project://database/Assets/Game/Content/Visual/UI/Kit/wainscot.png");
    background-repeat: repeat repeat;
    background-size: 42px 60px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    overflow: hidden;
}

.album-scroll {
    flex-grow: 1;
}

.album-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding: 4px 8px 40px 8px;
}

.album-section {
    height: 29px;
    margin: 12px 2px 6px 2px;
    padding: 0 12px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(255, 248, 234, 0.94);
    border-radius: 15px;
}

.album-section__title {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--ink);
}

.album-section__title--done {
    color: #C9922B;
}

.album-section__count {
    font-size: 12px;
    color: var(--ink-2);
}

/* Row pitch follows 09_album.png: 104px from plank to plank, items ~55px tall with a two-line name. */
.album-row {
    flex-direction: row;
    align-items: flex-end;
    height: 86px;
    margin-top: 6px;
}

.album-cell {
    width: 16.666%;
    align-items: center;
    justify-content: flex-end;
}

.album-cell__image {
    width: 48px;
    height: 62px;
    -unity-background-scale-mode: scale-to-fit;
    background-position-y: bottom;
}

.album-cell__name {
    height: 22px;
    margin-top: 0;
    font-size: 10px;
    color: var(--ink);
    -unity-text-align: upper-center;
    white-space: normal;
}

.album-plank {
    height: 12px;
    margin: 2px 0 0 0;
}
