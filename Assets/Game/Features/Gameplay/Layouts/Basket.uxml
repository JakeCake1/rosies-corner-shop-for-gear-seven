<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Game/Features/Gameplay/Layouts/Gameplay.uss" />
    <!-- Items sit in the slots between the back and the front of the basket. -->
    <ui:VisualElement class="basket" picking-mode="Ignore">
        <ui:VisualElement class="basket__back" picking-mode="Ignore" />
        <ui:VisualElement name="slots" class="basket__slots" picking-mode="Ignore">
            <ui:VisualElement class="basket__slot basket__slot--0" picking-mode="Ignore" />
            <ui:VisualElement class="basket__slot basket__slot--1" picking-mode="Ignore" />
            <ui:VisualElement class="basket__slot basket__slot--2" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="basket__front" picking-mode="Ignore" />
        <ui:VisualElement name="napkin" class="basket__napkin" picking-mode="Ignore" />
        <ui:VisualElement class="basket__tag kit-chip" picking-mode="Ignore">
            <ui:VisualElement name="tag-icon" class="basket__tag-icon" picking-mode="Ignore" />
            <ui:Label name="tag-count" text="0/3" class="basket__tag-count" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
