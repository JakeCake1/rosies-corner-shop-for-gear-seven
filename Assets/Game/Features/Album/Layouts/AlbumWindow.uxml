<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Game/Features/Album/Layouts/Album.uss" />
    <!-- 09_album.png: the shop background stays visible; sign, cabinet with planks per row of six items. -->
    <ui:VisualElement class="album-backdrop" picking-mode="Position">
        <ui:VisualElement class="wallpaper" picking-mode="Ignore" />
        <ui:VisualElement class="bunting icon-bunting" picking-mode="Ignore" />
    </ui:VisualElement>
    <ui:Button name="back" class="btn kit-btn-wood album-back">
        <ui:Label name="back-text" text="Back" class="album-back__text" />
    </ui:Button>
    <ui:VisualElement class="album-total kit-pill-white" picking-mode="Ignore">
        <ui:Label name="total" text="0 / 162" class="album-total__text" />
    </ui:VisualElement>
    <ui:VisualElement class="album-sign kit-board-walnut" picking-mode="Ignore">
        <ui:VisualElement class="sign-rope sign-rope--left" picking-mode="Ignore" />
        <ui:VisualElement class="sign-rope sign-rope--right" picking-mode="Ignore" />
        <ui:Label name="title" text="My Album" class="album-sign__title display-font" />
        <ui:Label name="subtitle" text="PACK A BASKET TO ADD ITS ITEM" class="album-sign__subtitle" />
    </ui:VisualElement>
    <ui:VisualElement class="album-cabinet">
        <ui:VisualElement class="album-cabinet__inner">
            <ui:ScrollView name="scroll" class="album-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
