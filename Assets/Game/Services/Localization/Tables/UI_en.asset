  - m_Id: 822792285
    m_Localized: Lovely!
    m_Metadata:
      m_Items: []
  - m_Id: 822792286
    m_Localized: Sweet!
    m_Metadata:
      m_Items: []
  - m_Id: 822792287
    m_Localized: Delicious!
    m_Metadata:
      m_Items: []
  - m_Id: 822792288
    m_Localized: Well done!
    m_Metadata:
      m_Items: []
  - m_Id: 822792289
    m_Localized: Perfect!
    m_Metadata:
      m_Items: []
  - m_Id: 822792290
    m_Localized: Yummy!
    m_Metadata:
      m_Items: []
  - m_Id: 822792291
    m_Localized: Neat!
    m_Metadata:
      m_Items: []
  - m_Id: 822792292
    m_Localized: Tidy shop!
    m_Metadata:
      m_Items: []
  - m_Id: 822792293
    m_Localized: Rosie is proud!
    m_Metadata:
      m_Items: []
  - m_Id: 822792294
    m_Localized: On a roll!
    m_Metadata:
      m_Items: []
  - m_Id: 822792295
    m_Localized: Busy hands!
    m_Metadata:
      m_Items: []
  - m_Id: 822792296
    m_Localized: What a streak!
    m_Metadata:
      m_Items: []
  - m_Id: 822792297
    m_Localized: The shop is buzzing!
    m_Metadata:
      m_Items: []
  - m_Id: 822792298
    m_Localized: Look at you go!
    m_Metadata:
      m_Items: []
  - m_Id: 822792299
    m_Localized: Level {0}
    m_Metadata:
      m_Items: []
  - m_Id: 822792300
