      m_Items: []
  - m_Id: 822792310
    m_Localized: "<b>{0}</b>\n<size=75%>{1} \xB7 {2}</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 822792311
    m_Localized: Play
    m_Metadata:
      m_Items: []
  - m_Id: 822792312
    m_Localized: Back to the shop
    m_Metadata:
      m_Items: []
  - m_Id: 822792313
    m_Localized: Not enough coins
    m_Metadata:
      m_Items: []
  - m_Id: 822792314
    m_Localized: Rosie's Corner Shop
    m_Metadata:
      m_Items: []
  - m_Id: 822792315
    m_Localized: "GROCERIES \xB7 BAKERY \xB7 SWEETS"
    m_Metadata:
      m_Items: []
  - m_Id: 822792316
    m_Localized: <u>For reviewers</u>
    m_Metadata:
      m_Items: []
  - m_Id: 822792317
    m_Localized: Album
    m_Metadata:
      m_Items: []
  - m_Id: 822792318
    m_Localized: Open the shop
    m_Metadata:
      m_Items: []
  - m_Id: 822792319
    m_Localized: Level {0}
    m_Metadata:
      m_Items: []
  - m_Id: 822792320
    m_Localized: "Level {0} \xB7 Tricky \xB7 Rewards \xD72"
    m_Metadata:
      m_Items: []
  - m_Id: 822792321
    m_Localized: The album opens after level {0}. Keep going!
    m_Metadata:
      m_Items: []
  - m_Id: 822792322
    m_Localized: You're my partner now!
    m_Metadata:
      m_Items: []
  - m_Id: 822792323
    m_Localized: 'Rosie: "Ten busy days! Let''s put your name on the sign. What shall
      we call the shop?"'
    m_Metadata:
      m_Items: []
  - m_Id: 822792324
    m_Localized: Rosie & Me
    m_Metadata:
      m_Items: []
  - m_Id: 822792325
    m_Localized: Maple Street Market
    m_Metadata:
      m_Items: []
  - m_Id: 822792326
    m_Localized: The Corner Pantry
    m_Metadata:
      m_Items: []
  - m_Id: 822792327
    m_Localized: Hang the sign
    m_Metadata:
      m_Items: []
  - m_Id: 822792328
    m_Localized: Keep Rosie's name
    m_Metadata:
      m_Items: []
  - m_Id: 822792329
    m_Localized: Settings
    m_Metadata:
      m_Items: []
  - m_Id: 822792330
    m_Localized: Sound
    m_Metadata:
      m_Items: []
  - m_Id: 822792331
    m_Localized: Music
    m_Metadata:
      m_Items: []
