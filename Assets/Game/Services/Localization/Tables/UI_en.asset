    m_Metadata:
      m_Items: []
  - m_Id: 822792301
    m_Localized: 'New: start boosters! Rosie gives you two of each. Pick what you
      want to begin the level with.'
    m_Metadata:
      m_Items: []
  - m_Id: 822792302
    m_Localized: A tricky one. A start booster helps!
    m_Metadata:
      m_Items: []
  - m_Id: 822792303
    m_Localized: Get ready. Pick a start booster if you like.
    m_Metadata:
      m_Items: []
  - m_Id: 822792304
    m_Localized: Extra basket
    m_Metadata:
      m_Items: []
  - m_Id: 822792305
    m_Localized: start with three baskets
    m_Metadata:
      m_Items: []
  - m_Id: 822792306
    m_Localized: Quick Pick
    m_Metadata:
      m_Items: []
  - m_Id: 822792307
    m_Localized: one extra for this level
    m_Metadata:
      m_Items: []
  - m_Id: 822792308
    m_Localized: '{0} left'
    m_Metadata:
      m_Items: []
  - m_Id: 822792309
    m_Localized: '{0} coins'
