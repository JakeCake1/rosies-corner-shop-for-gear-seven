/* Icons and pictures keep their aspect ratio. */
.icon-bunting {
    background-image: url("project://database/Assets/Game/Services/UI/Art/Icons/bunting.png");
    -unity-background-scale-mode: scale-to-fit;
}

.icon-coin {
    background-image: url("project://database/Assets/Game/Services/UI/Art/Icons/coin.png");
    -unity-background-scale-mode: scale-to-fit;
}

